# Example only. No real environment file is modified by Stage 6.
COUNSELOR_WORKFLOW_MODE=off
# Explicit ISO offset required; setting this alone never enables the feature.
COUNSELOR_WORKFLOW_ROLLOUT_AT=
# JSON object mapping counselor UUID to their prospective activation instant.
# Keep prior pilot entries when expanding; use a fresh global cutoff for mode=all.
COUNSELOR_WORKFLOW_PILOTS={}
COUNSELOR_WORKFLOW_WORKER_ENABLED=true
# Worker uses one coordinator connection plus per-lead transactions.
# Existing DB_POOL_MAX default is 20; never configure less than 2 when enabled.
